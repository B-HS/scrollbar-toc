{
    "name": "scrollbar-toc",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "package",
        "www"
    ],
    "scripts": {
        "dev": "bun run build:package && concurrently -n package,www -c blue,green \"bun run --cwd package dev\" \"bun run --cwd www dev\"",
        "build": "bun run build:package && bun run build:www",
        "build:package": "bun run --cwd package build",
        "build:www": "bun run --cwd www build",
        "preview": "bun run --cwd www preview",
        "format": "prettier --write .",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "feconfig-bhs": "^1.0.7",
        "happy-dom": "^18.0.1",
        "prettier": "^3.4.2",
        "tsdown": "^0.15.5",
        "typescript": "^5.7.2"
    }
}
