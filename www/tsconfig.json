{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun-types"],
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": ["src"]
}
